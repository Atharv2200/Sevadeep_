# Copy this file to backend/.env and adjust. Never commit backend/.env.

# Required. MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/sevadeep-ngo

# Optional (default 5000).
PORT=5000

# Optional (default development). Set to production when deploying.
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
# Optional in development (defaults to http://localhost:5173,http://127.0.0.1:5173).
# Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
