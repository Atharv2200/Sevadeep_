# Copy this file to backend/.env and adjust. Never commit backend/.env.

# Required. MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/sevadeep-ngo

# Required. Secret used to sign login tokens (at least 32 characters).
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Public origin of the web app. Used to build attendance QR URLs and to check the
# Origin header on state-changing requests. Optional in development (defaults to
# http://localhost:5173). Required in production, and must be https there.
# For phone testing set this to your HTTPS tunnel URL.
PUBLIC_APP_URL=http://localhost:5173

# Optional (default 100). The worst GPS accuracy, in metres, a check-in may report.
# A check-in with a larger (worse) value is rejected.
# MAX_ACCURACY_METERS=100

# Optional (default 5000).
PORT=5000

# Optional (default development). Set to production when deploying.
NODE_ENV=development

# Optional. Number of reverse-proxy hops to trust for the client IP (used by rate
# limiting), e.g. 1 behind a single proxy. Leave unset when there is no proxy.
# TRUST_PROXY=1

# Optional. Database for `npm test` (default mongodb://localhost:27017/sevadeep-ngo-test).
# The database name must end in "-test"; tests refuse to run otherwise.
# MONGODB_URI_TEST=mongodb://localhost:27017/sevadeep-ngo-test

# Optional. Local directory contribution photos are written to (default backend/uploads).
# Relative paths resolve against the backend directory. Never served as a static
# directory; photos are only reachable through the authenticated photo endpoint.
# UPLOAD_DIR=uploads

# Optional. Same as above, but for `npm test` (default backend/uploads-test).
# UPLOAD_DIR_TEST=uploads-test
